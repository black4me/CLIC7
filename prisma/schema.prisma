// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Staff/Admin Model
model Staff {
  id                String           @id @default(uuid())
  email             String           @unique
  fullName          String?
  password          String?
  role              StaffRole        @default(staff)
  permissions       StaffPermission[]
  isActive          Boolean          @default(true)
  twoFactorEnabled  Boolean          @default(false)
  twoFactorSecret   String?
  loginAttempts     Int              @default(0)
  isLocked          Boolean          @default(false)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?
  deletedBy         String?
  activities        StaffActivity[]

  @@index([email])
  @@index([role, isActive])
  @@index([isLocked])
  @@index([createdAt])
  @@map("staff")
}

model StaffPermission {
  id          String   @id @default(uuid())
  staffId     String
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  permission  String
  canPerform  Boolean  @default(true)

  @@index([staffId])
  @@map("staff_permissions")
}

enum StaffRole {
  admin
  supervisor
  staff
  support
  owner
}

// Transaction Model
model Transaction {
  id                String            @id @default(uuid())
  orderId           String
  customerId        String
  customerEmail     String?
  amount            Decimal           @db.Decimal(10, 2)
  currency          String
  paymentMethod     PaymentMethod
  status            TransactionStatus @default(pending)
  transactionId     String?           @unique
  receiptProofUrl   String?
  verificationNotes String?
  verifiedBy        String?
  verifiedAt        DateTime?
  gatewayResponse   Json?
  errorMessage      String?
  metadata          Json?
  version           Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@index([transactionId])
  @@index([verifiedBy])
  @@index([status, createdAt])
  @@index([orderId, status])
  @@index([customerId, createdAt])
  @@map("transactions")
}

enum PaymentMethod {
  stripe
  paypal
  thawani
  bank_transfer
  gift_card
  coupon
}

enum TransactionStatus {
  pending
  processing
  completed
  failed
  refunded
  verification_pending
  verification_rejected
}

// Coupon Model
model Coupon {
  id                   String    @id @default(uuid())
  code                 String    @unique
  description          String?
  discountType         DiscountType
  discountValue        Decimal   @db.Decimal(10, 2)
  maxUsages            Int
  currentUsages        Int       @default(0)
  usedBy               String[]  @default([])
  minOrderAmount       Decimal?  @db.Decimal(10, 2)
  maxDiscountAmount    Decimal?  @db.Decimal(10, 2)
  validFrom            DateTime
  validUntil           DateTime
  applicableCategories String[]  @default([])
  applicableProducts   String[]  @default([])
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([code])
  @@index([isActive, validFrom, validUntil])
  @@index([currentUsages, maxUsages])
  @@map("coupons")
}

enum DiscountType {
  percentage
  fixed_amount
}

// Gift Card Model
model GiftCard {
  id              String               @id @default(uuid())
  code            String               @unique
  balance         Decimal              @db.Decimal(10, 2)
  initialBalance  Decimal              @db.Decimal(10, 2)
  purchasedBy     String?
  sentTo          String?
  isActive        Boolean              @default(true)
  isRedeemed      Boolean              @default(false)
  expiresAt       DateTime?
  version         Int                  @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  transactions    GiftCardTransaction[]

  @@index([code])
  @@index([isActive, isRedeemed])
  @@index([expiresAt])
  @@map("giftcards")
}

// Gift Card Transaction Model
model GiftCardTransaction {
  id          String                 @id @default(uuid())
  giftCardId  String
  giftCard    GiftCard               @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  customerId  String
  orderId     String?
  amount      Decimal                @db.Decimal(10, 2)
  type        GiftCardTransactionType
  createdAt   DateTime               @default(now())

  @@index([giftCardId])
  @@index([customerId])
  @@index([orderId])
  @@index([giftCardId, createdAt])
  @@map("giftcard_transactions")
}

enum GiftCardTransactionType {
  redeem
  purchase
  refund
}

// Staff Activity Log Model
model StaffActivity {
  id        String   @id @default(uuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  action    String
  targetId  String?
  targetType String?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([staffId])
  @@index([targetId])
  @@index([createdAt])
  @@index([staffId, createdAt])
  @@map("staff_activities")
}

// Game Key Model
model GameKey {
  id            String      @id @default(uuid())
  encryptedKey  String
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  gameName      String
  platform      String
  status        GameKeyStatus @default(available)
  orderId       String?
  customerId    String?
  purchasedAt   DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([productId])
  @@index([status])
  @@index([orderId])
  @@index([customerId])
  @@index([productId, status])
  @@index([status, createdAt])
  @@map("gamekeys")
}

enum GameKeyStatus {
  available
  reserved
  sold
  revoked
}

// Order Model
model Order {
  id            String      @id @default(uuid())
  orderNumber   String      @unique
  customerId    String
  customerEmail String
  items         OrderItem[]
  total         Decimal     @db.Decimal(10, 2)
  currency      String
  status        OrderStatus @default(pending)
  paymentMethod String?
  transactionId String?
  couponCode    String?
  discountAmount Decimal    @default(0) @db.Decimal(10, 2)
  finalAmount   Decimal     @db.Decimal(10, 2)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([orderNumber])
  @@index([customerId])
  @@index([status])
  @@index([transactionId])
  @@index([status, createdAt])
  @@index([customerId, status])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  productName     String
  quantity        Int
  price           Decimal  @db.Decimal(10, 2)
  encryptedGameKey String?

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Product {
  id              String      @id @default(uuid())
  title           String
  slug            String      @unique
  price           Decimal     @db.Decimal(10, 2)
  originalPrice   Decimal?    @db.Decimal(10, 2)
  image           String
  description     String?     @db.Text
  genre           String?
  platform        String?
  isFlashSale     Boolean     @default(false)
  rating          Float?      @default(0)
  reviewsCount    Int?        @default(0)
  category        String?     @default("game")
  isActive        Boolean     @default(true)
  metadata        Json?       // For any additional fields from the Game interface
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  keys            GameKey[]
  orderItems      OrderItem[]

  @@index([slug])
  @@index([isActive])
  @@map("products")
}

enum OrderStatus {
  pending
  processing
  completed
  failed
  cancelled
  refunded
}

// Bank Account Model
model BankAccount {
  id              String   @id @default(uuid())
  bankName        String
  accountNumber   String
  accountHolder   String
  iban            String?
  swiftCode       String?
  phoneNumber     String?
  qrCodeImage     String?
  bankCardImage   String?
  isActive        Boolean  @default(true)
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive, isDefault])
  @@map("bankaccounts")
}